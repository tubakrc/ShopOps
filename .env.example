# Bu dosyayı .env olarak kopyala ve doldur. .env asla repoya girmez. [Ref: Genel Rehber §3]

# --- LLM sağlayıcısı: gemini | groq | ollama ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=

# Model kimliklerini AI Studio'daki "Get code" çıktısından doğrula.
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0

# Ücretsiz katman limitlerinin biraz altı (Flash Lite: 15 RPM / 500 RPD)
LLM_RPM=14
LLM_RPD=480

# --- Yollar (isteğe bağlı) ---
# SHOPOPS_DB=data/shopops.db
# LLM_CACHE_DB=.cache/llm_cache.db
